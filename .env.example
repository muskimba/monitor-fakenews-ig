# Copie para .env e preencha.

# ID da planilha Google (parte da URL entre /d/ e /edit). As abas perfis, noticias, postagens,
# ocorrencias, desmentidos e respostas são criadas por `python -m monitor init-planilha`.
PLANILHA_ID=

# Acesso: compartilhe a planilha como Editor com a service account e use UMA das opções:
# (a) sem arquivo de chave, via seu login do gcloud (`gcloud auth application-default login`):
GOOGLE_IMPERSONATE_SA=
# (b) arquivo JSON de chave da service account (guarde fora do OneDrive):
GOOGLE_APPLICATION_CREDENTIALS=

# Conta secundária do Instagram usada na coleta (sessão criada com `instaloader -l USUARIO`).
# IG_SESSION_FILE vazio = local padrão do instaloader (%LOCALAPPDATA%\Instaloader\session-USUARIO)
IG_USER=
IG_SESSION_FILE=

# Chave da API da Anthropic
ANTHROPIC_API_KEY=

# Opcionais
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MAX_POSTS_POR_PERFIL=12
PAUSA_ENTRE_PERFIS_S=20
